# ────────────────────────────────────────────────
# NotiFi-Server — 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요.
# .env 는 git 추적에서 제외됩니다.
#
# .env 는 docker compose 뿐 아니라 gradlew bootRun / IntelliJ 실행에서도
# 자동으로 읽힙니다 (application.yaml 의 spring.config.import).
# 단 import 경로가 상대 경로라 **프로젝트 루트에서 실행할 때만** 읽힙니다.
# IntelliJ 는 실행 구성의 Working directory 를 프로젝트 루트로 두세요 —
# 못 찾으면 에러 없이 기본값으로 떨어져 원인을 찾기 어렵습니다.
#
# 값은 .properties 규칙으로 파싱되므로 Windows 경로의 역슬래시는
# 이스케이프로 먹힙니다 — C:/Users/... 또는 C:\\Users\\... 로 쓰세요.
# ────────────────────────────────────────────────

# PostgreSQL
DB_NAME=notifi
DB_USERNAME=notifi
DB_PASSWORD=notifi
DB_URL=jdbc:postgresql://localhost:5432/notifi

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 내부 API 인증 키 (AI 서버 → Spring, X-Internal-Key 헤더)
INTERNAL_API_KEY=change-me-before-deploy

# JWT
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long!
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# Firebase 서비스 계정 키 경로 (FCM 발송용)
# 미설정이면 서버는 정상 부팅하되 FCM 발송을 건너뛰고 알림을 FAILED 로 기록합니다.
# 키 파일은 절대 레포 안에 두지 마세요.
# - FIREBASE_CREDENTIALS_PATH: bootRun/IntelliJ 실행에서 앱이 직접 읽는 경로
# - FIREBASE_KEY_FILE: docker compose app 컨테이너에 마운트할 호스트 경로
#   (컨테이너 안 경로는 compose 가 /run/secrets/firebase.json 으로 고정)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_KEY_FILE=

# 프로파일 (local | prod)
# prod 로 띄우면 ProdConfigGuard 가 부팅 시 아래를 검증하고 하나라도 걸리면 기동을 막습니다.
#   - JWT_SECRET 이 dev 기본값/예시값이 아닐 것 (32자 이상)
#   - INTERNAL_API_KEY 가 비어 있지 않고 change-me-before-deploy 가 아닐 것
#   - CORS_ALLOWED_ORIGINS 에 * 가 없을 것
SPRING_PROFILES_ACTIVE=local

# CORS 허용 origin (prod 에선 실제 도메인으로 교체, 쉼표 구분)
# 모바일 앱은 브라우저가 아니라 CORS 를 타지 않습니다 — 이 값은 Swagger 를 열어 쓸
# 도메인만 있으면 됩니다. prod 에서 * 는 부팅이 막힙니다.
CORS_ALLOWED_ORIGINS=*

# Swagger 노출 (true | false)
# Swagger 는 인증 없이 열리므로 API 전체 구조가 공개됩니다.
# prod 프로파일 기본값은 false 이고, 켜려면 여기서 true 를 명시하세요.
SWAGGER_ENABLED=true

# 치명 실패 알림 webhook (Discord·Slack 등). 비워 두면 알림이 비활성됩니다.
# 보내는 것은 "조용히 실패하면 사람이 다치는 것"뿐입니다 —
# 현재는 응급 FCM 이 등록된 토큰 전부에 실패한 경우.
ALERT_WEBHOOK_URL=
# 알림 문구에 붙는 환경 이름 (local | prod 등). 여러 환경을 한 채널로 받을 때 구분용.
ALERT_ENVIRONMENT=local

# ────────────────────────────────────────────────
# NotiFi-Server — 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요.
# .env 는 git 추적에서 제외됩니다.
#
# .env 는 docker compose 뿐 아니라 gradlew bootRun / IntelliJ 실행에서도
# 자동으로 읽힙니다 (application.yaml 의 spring.config.import).
# 단 import 경로가 상대 경로라 **프로젝트 루트에서 실행할 때만** 읽힙니다.
# IntelliJ 는 실행 구성의 Working directory 를 프로젝트 루트로 두세요 —
# 못 찾으면 에러 없이 기본값으로 떨어져 원인을 찾기 어렵습니다.
#
# 값은 .properties 규칙으로 파싱되므로 Windows 경로의 역슬래시는
# 이스케이프로 먹힙니다 — C:/Users/... 또는 C:\\Users\\... 로 쓰세요.
# ────────────────────────────────────────────────

# PostgreSQL
DB_NAME=notifi
DB_USERNAME=notifi
DB_PASSWORD=notifi
DB_URL=jdbc:postgresql://localhost:5432/notifi

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 내부 API 인증 키 (AI 서버 → Spring, X-Internal-Key 헤더)
INTERNAL_API_KEY=change-me-before-deploy

# JWT
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long!
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# Firebase 서비스 계정 키 경로 (FCM 발송용)
# 미설정이면 서버는 정상 부팅하되 FCM 발송을 건너뛰고 알림을 FAILED 로 기록합니다.
# 키 파일은 절대 레포 안에 두지 마세요.
FIREBASE_CREDENTIALS_PATH=

# 프로파일 (local | prod)
SPRING_PROFILES_ACTIVE=local

# CORS 허용 origin (prod 에선 실제 도메인으로 교체, 쉼표 구분)
CORS_ALLOWED_ORIGINS=*
